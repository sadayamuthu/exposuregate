    {
      "id": "uv-direct-kev",
      "lockfile_type": "uv",
      "old": "cases/uv-direct-kev/old/uv.lock",
      "new": "cases/uv-direct-kev/new/uv.lock",
      "expected_verdict": "BLOCK",
      "expected_exit_code": 1,
      "tags": [
        "direct",
        "kev"
      ],
      "expected_findings": [
        {
          "package": "litellm",
          "version": "1.83.6",
          "cve_id": "CVE-2026-42208",
          "dependency": "direct",
          "reason": "graded",
          "exposure_tier": "CRITICAL",
          "action": "block"
        },
        {
          "package": "litellm",
          "version": "1.83.6",
          "cve_id": "CVE-2026-42271",
